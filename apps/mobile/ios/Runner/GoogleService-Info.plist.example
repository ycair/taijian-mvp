<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Example only. Download the real file from Firebase Console:
	  Project settings → Your apps → iOS app (app.taijian.mobile) → Download plist.
	  Save it as ios/Runner/GoogleService-Info.plist and add it to the Runner target.
	  Never commit the real file.
	-->
	<key>API_KEY</key>
	<string>REPLACE_WITH_FIREBASE_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>app.taijian.mobile</string>
	<key>PROJECT_ID</key>
	<string>taijian-dev</string>
	<key>STORAGE_BUCKET</key>
	<string>taijian-dev.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>CLIENT_ID</key>
	<string>000000000000-REPLACE.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.000000000000-REPLACE</string>
</dict>
</plist>
