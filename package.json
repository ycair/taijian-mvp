{
  "name": "taijian",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm -r test",
    "test:rules": "pnpm --filter @taijian/functions test:rules",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed-emulator.ts",
    "mock:line": "tsx scripts/mock-line-server.ts",
    "build": "pnpm -r build",
    "deploy:functions": "node scripts/prepare-functions-deploy.mjs",
    "deploy:functions:check": "node scripts/check-functions-deploy.mjs",
    "emulators:prep": "node scripts/prepare-functions-deploy.mjs --emulator --project demo-taijian",
    "emulators:prep:check": "node scripts/check-emulator-env.mjs --mode=emulator --project demo-taijian",
    "lint": "eslint .",
    "format": "prettier --write .",
    "emulators": "pnpm emulators:prep && firebase emulators:start --only auth,firestore,functions --project demo-taijian",
    "emulators:check": "firebase emulators:exec --only firestore --project demo-taijian \"node scripts/check-emulators.mjs\"",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve --env-file supabase/functions/.env --no-verify-jwt",
    "dev:liff-sb": "pnpm --filter @taijian/liff-sb dev",
    "build:liff-sb": "pnpm --filter @taijian/liff-sb build",
    "test:liff-sb": "pnpm --filter @taijian/liff-sb test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.0.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
