{
  "name": "@taijian/functions",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/integration/**'",
    "test:integration": "firebase emulators:exec --config ../../firebase.json --only firestore,auth --project demo-taijian \"vitest run test/integration --no-file-parallelism\""
  },
  "dependencies": {
    "@taijian/domain": "workspace:*",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "luxon": "^3.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
