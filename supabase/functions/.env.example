# Local development (supabase start) — copy to .env and fill only local values.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
LINE_LOGIN_CHANNEL_ID=test-login-channel
LINE_MESSAGING_CHANNEL_SECRET=test-messaging-secret
LINE_CHANNEL_ACCESS_TOKEN=test-access-token
LIFF_ID=test-liff

# Local demo only. Omit or set false in a deployed project.
ALLOW_MOCK_LINE=true

# For a deployed project, set SUPABASE_DB_URL to the project's Postgres connection string
# if the Edge Runtime does not provide it automatically.
# SUPABASE_DB_URL=postgresql://...
